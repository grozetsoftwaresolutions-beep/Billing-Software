{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServerConfiguration": {
    "HttpPort": 5100,
    "HttpsPort": 5101,
    "UseHttps": false,
    "BindToAllInterfaces": false,
    "ListenAddress": "127.0.0.1",
    "AllowedSubnet": "192.168.1.0/24",
    "ServerId": "SRV-PROD-01",
    "StoreId": "STORE-001",
    "StoreName": "Grozet Supermarket",
    "DataDirectory": "%ProgramData%\\GrozetPOS\\Data",
    "LogsDirectory": "%ProgramData%\\GrozetPOS\\Logs",
    "BackupsDirectory": "%ProgramData%\\GrozetPOS\\Backups",
    "DatabaseFileName": "grozet_pos.db",
    "RequestTimeoutSeconds": 30,
    "MaxRequestBodySizeBytes": 10485760
  }
}
