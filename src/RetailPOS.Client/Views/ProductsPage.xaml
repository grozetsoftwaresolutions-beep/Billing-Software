<Page
    x:Class="RetailPOS.Client.Views.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:RetailPOS.Client.ViewModels"
    xmlns:inv="using:RetailPOS.Contracts.Inventory"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="#F8FAFC">

    <Grid RowSpacing="16" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header Card & Actions -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24, 18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="40" Height="40" Background="#EFF6FF" CornerRadius="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE719;" FontSize="20" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Products &amp; Stock" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="Authoritative Catalog, Inventory Balances &amp; Stock Movement Ledger" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Segmented Navigation Tabs -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button x:Name="TabCatalogBtn" Content="Product Catalog" Click="OnTabCatalogClicked"
                                Style="{x:Bind CatalogTabStyle, Mode=OneWay}" />
                        <Button x:Name="TabInventoryBtn" Content="Inventory &amp; Stock" Click="OnTabInventoryClicked"
                                Style="{x:Bind InventoryTabStyle, Mode=OneWay}" />
                        <Button x:Name="TabMovementsBtn" Content="Stock Movement Ledger" Click="OnTabMovementsClicked"
                                Style="{x:Bind MovementsTabStyle, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="Refresh (F5)" Click="OnRefreshClicked">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Content="+ New Product (Ctrl+N)" Click="OnNewProductClicked" Style="{StaticResource AccentButtonStyle}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Notifications & Loading -->
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="{x:Bind HasSuccessMessage, Mode=OneWay}"
                     Severity="Success"
                     Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                     CloseButtonClick="OnDismissSuccess" />

            <InfoBar IsOpen="{x:Bind HasErrorMessage, Mode=OneWay}"
                     Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     CloseButtonClick="OnDismissError" />

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" Height="3" />
        </StackPanel>

        <!-- 3. Tab Content Area -->
        <Grid Grid.Row="2">

            <!-- TAB 0: PRODUCT CATALOG -->
            <Grid Visibility="{x:Bind CatalogTabVisibility, Mode=OneWay}" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Filter Bar -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16, 10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Category Filter -->
                        <ComboBox Grid.Column="0" Header="Category" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{x:Bind ViewModel.SelectedCategoryId, Mode=TwoWay}"
                                  PlaceholderText="All Categories"
                                  SelectionChanged="OnFilterChanged" />

                        <!-- Brand Filter -->
                        <ComboBox Grid.Column="1" Header="Brand" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.Brands, Mode=OneWay}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{x:Bind ViewModel.SelectedBrandId, Mode=TwoWay}"
                                  PlaceholderText="All Brands"
                                  SelectionChanged="OnFilterChanged" />

                        <!-- Status Filter -->
                        <ComboBox Grid.Column="2" Header="Status" HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind StatusFilterIndex, Mode=TwoWay}"
                                  SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="All Products" />
                            <ComboBoxItem Content="Active Only" />
                            <ComboBoxItem Content="Inactive Only" />
                        </ComboBox>

                        <!-- Clear Filters -->
                        <Button Grid.Column="4" Content="Clear Filters" Click="OnClearFiltersClicked" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <!-- Products Table -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Row -->
                        <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16, 10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SKU" FontWeight="Bold" FontSize="11" Foreground="#475569" />
                                <TextBlock Grid.Column="1" Text="PRODUCT NAME" FontWeight="Bold" FontSize="11" Foreground="#475569" />
                                <TextBlock Grid.Column="2" Text="CATEGORY" FontWeight="Bold" FontSize="11" Foreground="#475569" />
                                <TextBlock Grid.Column="3" Text="UNIT" FontWeight="Bold" FontSize="11" Foreground="#475569" />
                                <TextBlock Grid.Column="4" Text="COST (₹)" FontWeight="Bold" FontSize="11" Foreground="#475569" TextAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="SELLING (₹)" FontWeight="Bold" FontSize="11" Foreground="#475569" TextAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="STOCK" FontWeight="Bold" FontSize="11" Foreground="#475569" TextAlignment="Right" />
                                <TextBlock Grid.Column="7" Text="STATUS" FontWeight="Bold" FontSize="11" Foreground="#475569" TextAlignment="Center" />
                                <TextBlock Grid.Column="8" Text="ACTIONS" FontWeight="Bold" FontSize="11" Foreground="#475569" TextAlignment="Right" />
                            </Grid>
                        </Border>

                        <!-- Table Rows -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Products, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProductItemViewModel">
                                    <Grid ColumnSpacing="8" Padding="8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{x:Bind Sku}" FontWeight="SemiBold" Foreground="#1E3E62" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind CategoryName}" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind UnitCode}" Foreground="#475569" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind FormattedCostPrice}" Foreground="#64748B" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind FormattedSellingPrice}" FontWeight="SemiBold" Foreground="#0F172A" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind FormattedCurrentStock}" FontWeight="Medium" Foreground="#0F172A" TextAlignment="Right" VerticalAlignment="Center" />

                                        <Border Grid.Column="7" Background="{x:Bind StatusColor}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StatusText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>

                                        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="Edit" Click="OnEditProductRowClicked" Tag="{x:Bind}" Padding="8,4" FontSize="11" />
                                            <Button Content="Toggle" Click="OnToggleStatusRowClicked" Tag="{x:Bind}" Padding="6,4" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Pagination Bar -->
                <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16, 8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Bind PaginationSummaryText, Mode=OneWay}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Previous" Command="{x:Bind ViewModel.PreviousPageCommand}" IsEnabled="{x:Bind CanPagePrevious, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind PageNumberText, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                            <Button Content="Next" Command="{x:Bind ViewModel.NextPageCommand}" IsEnabled="{x:Bind CanPageNext, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 1: INVENTORY & STOCK -->
            <Grid Visibility="{x:Bind InventoryTabVisibility, Mode=OneWay}" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Inventory Control Bar -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16, 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <ToggleButton Content="{x:Bind LowStockFilterButtonText, Mode=OneWay}"
                                          IsChecked="{x:Bind ViewModel.InventoryVm.LowStockOnly, Mode=TwoWay}"
                                          Click="OnLowStockToggled" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="Refresh Stock" Click="OnRefreshStockClicked" />
                    </Grid>
                </Border>

                <!-- Stock Table -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Row -->
                        <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16, 10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SKU" FontWeight="Bold" FontSize="11" Foreground="#475569" />
                                <TextBlock Grid.Column="1" Text="PRODUCT NAME" FontWeight="Bold" FontSize="11" Foreground="#475569" />
                                <TextBlock Grid.Column="2" Text="UNIT" FontWeight="Bold" FontSize="11" Foreground="#475569" />
                                <TextBlock Grid.Column="3" Text="CURRENT STOCK" FontWeight="Bold" FontSize="11" Foreground="#475569" TextAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="REORDER LEVEL" FontWeight="Bold" FontSize="11" Foreground="#475569" TextAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="STOCK STATUS" FontWeight="Bold" FontSize="11" Foreground="#475569" TextAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="ACTIONS" FontWeight="Bold" FontSize="11" Foreground="#475569" TextAlignment="Right" />
                            </Grid>
                        </Border>

                        <!-- Rows -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.InventoryVm.StockItems, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="inv:StockBalanceDto">
                                    <Grid ColumnSpacing="12" Padding="8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{x:Bind Sku}" FontWeight="SemiBold" Foreground="#1E3E62" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProductName}" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind UnitCode}" Foreground="#475569" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind CurrentStock}" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind ReorderLevel}" Foreground="#64748B" TextAlignment="Right" VerticalAlignment="Center" />

                                        <Border Grid.Column="5" Background="#FEF3C7" CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{x:Bind IsLowStock}">
                                            <TextBlock Text="LOW STOCK" FontSize="9" FontWeight="Bold" Foreground="#B45309" />
                                        </Border>

                                        <Button Grid.Column="6" Content="Adjust Stock" Click="OnAdjustStockRowClicked" Tag="{x:Bind}"
                                                Style="{StaticResource AccentButtonStyle}" Padding="8,4" FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 2: STOCK MOVEMENT LEDGER -->
            <Grid Visibility="{x:Bind MovementsTabVisibility, Mode=OneWay}" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Movements Control Bar -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16, 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Append-Only Stock Movement Audit Ledger" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh Movements" Click="OnRefreshMovementsClicked" />
                    </Grid>
                </Border>

                <!-- Movements Table -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16, 10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DATE / TIME" FontWeight="Bold" FontSize="11" Foreground="#475569" />
                                <TextBlock Grid.Column="1" Text="PRODUCT" FontWeight="Bold" FontSize="11" Foreground="#475569" />
                                <TextBlock Grid.Column="2" Text="TYPE" FontWeight="Bold" FontSize="11" Foreground="#475569" TextAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="CHANGED" FontWeight="Bold" FontSize="11" Foreground="#475569" TextAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="RESULTING" FontWeight="Bold" FontSize="11" Foreground="#475569" TextAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="REFERENCE" FontWeight="Bold" FontSize="11" Foreground="#475569" />
                                <TextBlock Grid.Column="6" Text="REASON" FontWeight="Bold" FontSize="11" Foreground="#475569" />
                            </Grid>
                        </Border>

                        <!-- Rows -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.InventoryVm.Movements, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:StockMovementViewModel">
                                    <Grid ColumnSpacing="10" Padding="8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{x:Bind FormattedTimestamp}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProductName}" FontWeight="Medium" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                        <Border Grid.Column="2" Background="{x:Bind MovementTypeBadgeColor}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind MovementTypeName}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{x:Bind FormattedQuantityChanged}" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind FormattedResultingQuantity}" Foreground="#475569" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind ReferenceNumber}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind Reason}" Foreground="#475569" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Page>
