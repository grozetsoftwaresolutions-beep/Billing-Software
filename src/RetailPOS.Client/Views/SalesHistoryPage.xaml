<Page
    x:Class="RetailPOS.Client.Views.SalesHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:RetailPOS.Client.ViewModels"
    mc:Ignorable="d"
    Background="#F8FAFC">

    <Grid RowSpacing="16" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header Card -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24, 18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="42" Height="42" Background="#EFF6FF" CornerRadius="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE823;" FontSize="20" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sales History &amp; Invoices" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="Authoritative transaction records, invoice detail viewing, and secure receipt reprinting" FontSize="12" Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="Refresh (F5)" Click="OnRefreshClicked">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Notifications, Warnings & Progress -->
        <StackPanel Grid.Row="1" Spacing="8">
            <!-- Timezone Warning -->
            <InfoBar IsOpen="{x:Bind HasWarningMessage, Mode=OneWay}"
                     Severity="Warning"
                     Title="Store Time Zone Notice"
                     Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
                     IsClosable="False" />

            <!-- General / Error Message -->
            <InfoBar IsOpen="{x:Bind HasErrorMessage, Mode=OneWay}"
                     Severity="Error"
                     Title="Sales History Notice"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="True"
                     CloseButtonClick="OnDismissError" />

            <!-- Reprint Status Notification -->
            <InfoBar IsOpen="{x:Bind HasReprintMessage, Mode=OneWay}"
                     Severity="{x:Bind ReprintBarSeverity, Mode=OneWay}"
                     Title="Reprint Status"
                     Message="{x:Bind ViewModel.ReprintMessage, Mode=OneWay}"
                     IsClosable="True"
                     CloseButtonClick="OnDismissReprintMessage" />

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" Height="3" />
        </StackPanel>

        <!-- 3. Filter Bar & Master-Detail Area -->
        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Filter Controls Bar -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16, 12">
                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search by Invoice Number -->
                    <TextBox Grid.Column="0"
                             Header="Search by Invoice Number"
                             PlaceholderText="e.g. INV-20261017-0001"
                             Text="{x:Bind ViewModel.SearchInvoiceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchBoxKeyDown"
                             AutomationProperties.AutomationId="SearchInvoiceNumberInput" />

                    <!-- Start Date Picker -->
                    <DatePicker Grid.Column="1"
                                x:Name="StartDatePicker"
                                Header="Start Date"
                                SelectedDate="{x:Bind ViewModel.StartDate, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsDateFilterEnabled, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="StartDatePicker" />

                    <!-- End Date Picker -->
                    <DatePicker Grid.Column="2"
                                x:Name="EndDatePicker"
                                Header="End Date"
                                SelectedDate="{x:Bind ViewModel.EndDate, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsDateFilterEnabled, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="EndDatePicker" />

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="Search"
                                Click="OnSearchClicked"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="SearchSalesButton" />
                        <Button Content="Clear"
                                Click="OnClearClicked"
                                AutomationProperties.AutomationId="ClearFiltersButton" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Master-Detail Content -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Master: Sales List -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- List Header -->
                        <Border Grid.Row="0" Background="#F8FAFC" Padding="16, 12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sales Transactions" FontWeight="SemiBold" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PaginationSummary, Mode=OneWay}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Sales List -->
                        <ListView Grid.Row="1"
                                  x:Name="SalesListView"
                                  ItemsSource="{x:Bind ViewModel.Sales, Mode=OneWay}"
                                  SelectionChanged="OnSalesSelectionChanged"
                                  AutomationProperties.AutomationId="SalesListView">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SaleSummaryItemViewModel">
                                    <Grid Padding="12, 10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Invoice #, Date, Items & Payment Summary -->
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind InvoiceNumber}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                                                <Border Background="{x:Bind StatusBadgeBackground}" CornerRadius="4" Padding="6, 1">
                                                    <TextBlock Text="{x:Bind StatusDisplay}" Foreground="{x:Bind StatusBadgeForeground}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind FormattedDateTime}" FontSize="11" Foreground="#64748B" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind ItemCountDisplay}" FontSize="11" Foreground="#475569" />
                                                <TextBlock Text="•" FontSize="11" Foreground="#94A3B8" />
                                                <TextBlock Text="{x:Bind PaymentSummary}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right: Total Amount -->
                                        <TextBlock Grid.Column="1" Text="{x:Bind FormattedTotal}" FontWeight="Bold" FontSize="15" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty Placeholder -->
                        <StackPanel Grid.Row="1"
                                    Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10"
                                    Padding="24">
                            <Border Width="48" Height="48" Background="#F1F5F9" CornerRadius="24" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No sales found" FontWeight="SemiBold" FontSize="14" Foreground="#475569" HorizontalAlignment="Center" />
                            <TextBlock Text="No transactions match the selected filter." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>

                        <!-- Pagination Footer -->
                        <Border Grid.Row="2" Background="#F8FAFC" Padding="12, 8" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="&lt; Prev"
                                        Command="{x:Bind ViewModel.PreviousPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                                        AutomationProperties.AutomationId="PrevPageButton" />

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind PageNumberDisplay, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="2"
                                        Content="Next &gt;"
                                        Command="{x:Bind ViewModel.NextPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                                        AutomationProperties.AutomationId="NextPageButton" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Detail: Invoice View -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <!-- No Selection Placeholder -->
                        <StackPanel Visibility="{x:Bind NoDetailVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12"
                                    Padding="32">
                            <Border Width="56" Height="56" Background="#EFF6FF" CornerRadius="28" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8A1;" FontSize="24" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select an Invoice" FontWeight="Bold" FontSize="16" Foreground="#0F172A" HorizontalAlignment="Center" />
                            <TextBlock Text="Choose a transaction from the sales list to view authoritative details, payment records, and reprint receipt."
                                       FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="320" />
                        </StackPanel>

                        <!-- Detail Loading -->
                        <ProgressRing Visibility="{x:Bind DetailLoadingVisibility, Mode=OneWay}"
                                      IsActive="True"
                                      Width="40"
                                      Height="40"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />

                        <!-- Detail View (When Selected) -->
                        <ScrollViewer Visibility="{x:Bind DetailVisibility, Mode=OneWay}" Padding="24">
                            <StackPanel Spacing="18">
                                <!-- Detail Header -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.InvoiceNumber, Mode=OneWay}"
                                                       FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                                            <Border Background="#DCFCE7" CornerRadius="4" Padding="8, 2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.StatusDisplay, Mode=OneWay}"
                                                           Foreground="#15803D" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.FormattedCreatedAt, Mode=OneWay}"
                                                   FontSize="12" Foreground="#64748B" />
                                    </StackPanel>

                                    <!-- Reprint Button -->
                                    <Button Grid.Column="1"
                                            x:Name="ReprintReceiptButton"
                                            Click="OnReprintReceiptClicked"
                                            IsEnabled="{x:Bind NotReprinting, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="16, 8"
                                            AutomationProperties.AutomationId="ReprintReceiptButton">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE749;" FontSize="14" />
                                            <TextBlock Text="Reprint Receipt" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Metadata Summary Bar -->
                                <Border Background="#F8FAFC" CornerRadius="6" Padding="16, 12" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Cashier -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Staff / Cashier" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.CashierDisplayName, Mode=OneWay}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        </StackPanel>

                                        <!-- Reprint Count -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Reprint Count" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.ReprintCount, Mode=OneWay}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        </StackPanel>

                                        <!-- Last Reprinted At -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Last Reprinted" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.FormattedLastReprintedAt, Mode=OneWay}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                        </StackPanel>

                                        <!-- Final Amount -->
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Total Payable" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.FormattedFinalPayable, Mode=OneWay}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#15803D" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Items Section -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Purchased Items" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Table Header -->
                                            <Border Grid.Row="0" Background="#F1F5F9" Padding="12, 8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Item Description" FontWeight="SemiBold" FontSize="11" Foreground="#475569" />
                                                    <TextBlock Grid.Column="1" Text="Qty" FontWeight="SemiBold" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="2" Text="Unit Price" FontWeight="SemiBold" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="Discount" FontWeight="SemiBold" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="4" Text="Tax" FontWeight="SemiBold" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="5" Text="Total" FontWeight="SemiBold" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>

                                            <!-- Lines List -->
                                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SelectedSaleDetail.Items, Mode=OneWay}" SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SaleInvoiceItemLineViewModel">
                                                        <Grid Padding="12, 8" BorderBrush="#F8FAFC" BorderThickness="0,0,0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="100" />
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="80" />
                                                                <ColumnDefinition Width="100" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{x:Bind ProductName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" />
                                                                <TextBlock Text="{x:Bind Sku}" FontSize="10" Foreground="#64748B" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{x:Bind FormattedQuantity}" FontSize="12" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedUnitPrice}" FontSize="12" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" Text="{x:Bind FormattedDiscount}" FontSize="12" Foreground="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="4" Text="{x:Bind FormattedTax}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="5" Text="{x:Bind FormattedLineTotal}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Financial Totals & Payments Grid -->
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="320" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Payments & Tax Breakdown -->
                                    <StackPanel Grid.Column="0" Spacing="16">
                                        <!-- Payments -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Payment Records" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                                <ListView ItemsSource="{x:Bind ViewModel.SelectedSaleDetail.Payments, Mode=OneWay}" SelectionMode="None">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SalePaymentLineViewModel">
                                                            <Grid Padding="0, 4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6, 2">
                                                                        <TextBlock Text="{x:Bind Method}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" />
                                                                    </Border>
                                                                    <TextBlock Text="{x:Bind ReferenceNumber}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{x:Bind FormattedAmount}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Border>
                                        </StackPanel>

                                        <!-- Tax Breakdown -->
                                        <StackPanel Spacing="6" Visibility="{x:Bind TaxComponentsVisibility, Mode=OneWay}">
                                            <TextBlock Text="Tax Breakdown" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                                <ListView ItemsSource="{x:Bind ViewModel.SelectedSaleDetail.TaxComponents, Mode=OneWay}" SelectionMode="None">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SaleTaxComponentViewModel">
                                                            <Grid Padding="0, 3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{x:Bind ComponentName}" FontSize="11" Foreground="#475569" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind FormattedRate}" FontSize="11" Foreground="#64748B" Margin="10,0" />
                                                                <TextBlock Grid.Column="2" Text="{x:Bind FormattedAmount}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Right: Summary Table -->
                                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Invoice Summary" FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,4" />

                                            <Grid>
                                                <TextBlock Text="Gross Subtotal" FontSize="12" Foreground="#64748B" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.FormattedGrossSubtotal, Mode=OneWay}"
                                                           FontSize="12" Foreground="#0F172A" HorizontalAlignment="Right" />
                                            </Grid>

                                            <Grid>
                                                <TextBlock Text="Line Discounts" FontSize="12" Foreground="#64748B" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.FormattedLineDiscounts, Mode=OneWay}"
                                                           FontSize="12" Foreground="#EF4444" HorizontalAlignment="Right" />
                                            </Grid>

                                            <Grid>
                                                <TextBlock Text="Invoice Discount" FontSize="12" Foreground="#64748B" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.FormattedInvoiceDiscount, Mode=OneWay}"
                                                           FontSize="12" Foreground="#EF4444" HorizontalAlignment="Right" />
                                            </Grid>

                                            <Grid>
                                                <TextBlock Text="Taxable Subtotal" FontSize="12" Foreground="#64748B" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.FormattedTaxableSubtotal, Mode=OneWay}"
                                                           FontSize="12" Foreground="#0F172A" HorizontalAlignment="Right" />
                                            </Grid>

                                            <Grid>
                                                <TextBlock Text="Total Taxes" FontSize="12" Foreground="#64748B" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.FormattedTotalTax, Mode=OneWay}"
                                                           FontSize="12" Foreground="#0F172A" HorizontalAlignment="Right" />
                                            </Grid>

                                            <Grid>
                                                <TextBlock Text="Rounding Adjustment" FontSize="12" Foreground="#64748B" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.FormattedRoundingAdjustment, Mode=OneWay}"
                                                           FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" />
                                            </Grid>

                                            <Border Height="1" Background="#CBD5E1" Margin="0, 4" />

                                            <Grid>
                                                <TextBlock Text="Final Payable" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSaleDetail.FormattedFinalPayable, Mode=OneWay}"
                                                           FontWeight="Bold" FontSize="16" Foreground="#15803D" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Duplicate Warning Modal Overlay (Appears on Unknown Outcome) -->
        <Grid Visibility="{x:Bind DuplicateModalVisibility, Mode=OneWay}"
              Background="#99000000"
              Grid.Row="0"
              Grid.RowSpan="3"
              Canvas.ZIndex="1000">
            <Border Background="White"
                    CornerRadius="12"
                    Width="500"
                    Padding="28"
                    BorderBrush="#F59E0B"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="44" Height="44" Background="#FEF3C7" CornerRadius="22" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7BA;" FontSize="22" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Potential Duplicate Receipt" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="Physical Receipt Status Unknown" FontSize="12" Foreground="#B45309" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.DuplicateWarningMessage, Mode=OneWay}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#334155"
                               LineHeight="20" />

                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12">
                        <TextBlock Text="OPERATOR WARNING: Inspect the physical ESC/POS printer. If a receipt already emerged, cancel this dialog to avoid a duplicate customer receipt. Only confirm if the printer produced nothing."
                                   FontSize="11" Foreground="#92400E" TextWrapping="Wrap" FontWeight="Medium" />
                    </Border>

                    <Grid ColumnSpacing="12" Margin="0, 8, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Cancel (No Reprint)"
                                Click="OnCancelDuplicateClicked"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="CancelDuplicateRetryButton" />

                        <Button Grid.Column="1"
                                Content="Confirm Duplicate Reprint"
                                Click="OnConfirmDuplicateClicked"
                                HorizontalAlignment="Stretch"
                                Background="#DC2626"
                                Foreground="White"
                                FontWeight="Bold"
                                AutomationProperties.AutomationId="ConfirmDuplicateReprintButton" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
