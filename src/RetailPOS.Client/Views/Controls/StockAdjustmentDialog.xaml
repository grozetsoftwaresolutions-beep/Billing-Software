<ContentDialog
    x:Class="RetailPOS.Client.Views.Controls.StockAdjustmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:RetailPOS.Client.ViewModels"
    mc:Ignorable="d"
    Title="Manual Stock Adjustment"
    PrimaryButtonText="Confirm Adjustment"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="12">

    <StackPanel Spacing="16" Width="400" Padding="4">
        <!-- Error Alert -->
        <InfoBar IsOpen="{x:Bind HasErrorMessage, Mode=OneWay}"
                 Severity="Error"
                 Message="{x:Bind ViewModel.AdjustmentErrorMessage, Mode=OneWay}"
                 IsClosable="False" />

        <!-- Target Product Card -->
        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{x:Bind TargetProductText, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Current Stock:" FontSize="12" Foreground="#64748B" />
                    <TextBlock Text="{x:Bind ViewModel.FormattedCurrentStock, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Adjustment Direction -->
        <RadioButtons Header="Adjustment Type *" SelectedIndex="{x:Bind AdjustmentTypeIndex, Mode=TwoWay}">
            <RadioButton Content="Stock Increase (+)" />
            <RadioButton Content="Stock Decrease (-)" />
        </RadioButtons>

        <!-- Quantity Input -->
        <TextBox Header="Adjustment Quantity *" Text="{x:Bind ViewModel.AdjustmentQuantityText, Mode=TwoWay}"
                 PlaceholderText="e.g. 5" InputScope="Number" TextChanged="OnQuantityChanged" />

        <!-- Reason Input -->
        <TextBox Header="Reason for Adjustment *" Text="{x:Bind ViewModel.AdjustmentReasonText, Mode=TwoWay}"
                 PlaceholderText="e.g. Physical inventory variance, Damaged in transit..."
                 MaxLength="250" AcceptsReturn="True" Height="65" TextWrapping="Wrap" />

        <!-- Projected Stock Summary Card -->
        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Projected Resulting Stock:" FontWeight="SemiBold" FontSize="13" Foreground="#1E40AF" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FormattedProjectedStock, Mode=OneWay}" FontWeight="Bold" FontSize="15" Foreground="#1D4ED8" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </StackPanel>
</ContentDialog>
