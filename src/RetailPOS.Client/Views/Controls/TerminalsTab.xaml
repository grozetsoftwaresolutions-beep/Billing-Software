<UserControl
    x:Class="RetailPOS.Client.Views.Controls.TerminalsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:RetailPOS.Client.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,16">
        <StackPanel Spacing="20" MaxWidth="960" HorizontalAlignment="Left">
            <!-- Header & Token Generator Panel -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Terminal Enrollment &amp; Fleet Management" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="Generate cryptographically signed, one-time enrollment tokens to pair new POS counter workstations."
                                       FontSize="12" Foreground="#64748B" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Content="Generate Enrollment Token"
                                    Click="OnGenerateEnrollmentTokenClicked"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    AutomationProperties.AutomationId="GenerateEnrollmentTokenButton" />

                            <Button Content="Refresh List"
                                    Click="OnRefreshClicked"
                                    AutomationProperties.AutomationId="RefreshTerminalsButton" />
                        </StackPanel>
                    </Grid>

                    <!-- Generated Token Display Banner (Visible when token generated) -->
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="16"
                            Visibility="{x:Bind GeneratedTokenVisibility}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#16A34A" />
                                <TextBlock Text="{x:Bind ViewModel.GeneratedTokenPurpose, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="13" Foreground="#15803D" />
                                <TextBlock Text="(Expires in 15 minutes)" FontSize="12" Foreground="#16A34A" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{x:Bind ViewModel.GeneratedEnrollmentToken, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         FontSize="14"
                                         AutomationProperties.AutomationId="GeneratedTokenTextBox" />

                                <Button Grid.Column="1" Content="Copy Token"
                                        Click="OnCopyTokenClicked"
                                        AutomationProperties.AutomationId="CopyTokenButton" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Terminals Fleet List Card -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Registered Counter Terminals" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />

                    <!-- Terminals Items Repeater / ListView -->
                    <ListView ItemsSource="{x:Bind ViewModel.Terminals, Mode=OneWay}"
                              SelectionMode="None"
                              AutomationProperties.AutomationId="TerminalsListView">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TerminalItemViewModel">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Terminal Icon -->
                                        <Border Grid.Column="0" Width="40" Height="40" Background="#E0E7FF" CornerRadius="8">
                                            <FontIcon Glyph="&#xE7F8;" FontSize="18" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Code & ID -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind TerminalCode}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                                            <TextBlock Text="{x:Bind TerminalName}" FontSize="12" Foreground="#64748B" />
                                        </StackPanel>

                                        <!-- Printer & Target details -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Id}" FontFamily="Consolas" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock Text="{x:Bind ReceiptPrinterName}" FontSize="12" Foreground="#475569" />
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="3"
                                                Background="{x:Bind StatusBadgeColor}"
                                                CornerRadius="6"
                                                Padding="10,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind StatusText}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Border>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Content="{x:Bind ToggleStatusButtonText}"
                                                    Click="OnToggleStatusClicked"
                                                    AutomationProperties.AutomationId="ToggleTerminalStatusButton" />

                                            <Button Content="Repair Token"
                                                    Click="OnRepairTokenClicked"
                                                    AutomationProperties.AutomationId="RepairTokenButton" />

                                            <Button Content="Decommission"
                                                    Click="OnDecommissionClicked"
                                                    Foreground="#DC2626"
                                                    AutomationProperties.AutomationId="DecommissionTerminalButton" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
