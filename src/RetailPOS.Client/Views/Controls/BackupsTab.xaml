<UserControl
    x:Class="RetailPOS.Client.Views.Controls.BackupsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:RetailPOS.Client.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,16">
        <StackPanel Spacing="20" MaxWidth="960" HorizontalAlignment="Left">
            <!-- Create Backup Action Card -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Create Database Snapshot" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{x:Bind ViewModel.NewBackupReason, Mode=TwoWay}"
                                 PlaceholderText="Backup reason / note (optional, e.g. Pre-maintenance snapshot)"
                                 VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="BackupReasonTextBox" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Content="Create Backup Now"
                                    Click="OnCreateBackupClicked"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="20,8"
                                    CornerRadius="6"
                                    IsEnabled="{x:Bind IsCreateEnabled}"
                                    AutomationProperties.AutomationId="CreateBackupButton" />

                            <Button Content="Refresh History"
                                    Click="OnRefreshClicked"
                                    AutomationProperties.AutomationId="RefreshBackupsButton" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Backups Ledger / History Card -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Database Backup Archives &amp; Retention History" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />

                    <!-- Backups List -->
                    <ListView ItemsSource="{x:Bind ViewModel.Backups, Mode=OneWay}"
                              SelectionMode="None"
                              AutomationProperties.AutomationId="BackupsListView">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BackupItemViewModel">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Archive Icon -->
                                        <FontIcon Grid.Column="0" Glyph="&#xE753;" FontSize="18" Foreground="#64748B" VerticalAlignment="Center" />

                                        <!-- File Name -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" />
                                            <TextBlock Text="{x:Bind OperationId}" FontFamily="Consolas" FontSize="10" Foreground="#94A3B8" />
                                        </StackPanel>

                                        <!-- File Size -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontSize="12" FontWeight="Medium" Foreground="#334155" VerticalAlignment="Center" />

                                        <!-- Status Badge -->
                                        <Border Grid.Column="3"
                                                Background="#DCFCE7"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                        </Border>

                                        <!-- Timestamp -->
                                        <TextBlock Grid.Column="4" Text="{x:Bind FormattedCreatedAt}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />

                                        <!-- Triggered By -->
                                        <TextBlock Grid.Column="5" Text="{x:Bind TriggeredBy}" FontSize="12" Foreground="#475569" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
