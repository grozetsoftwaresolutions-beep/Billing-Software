<Page
    x:Class="RetailPOS.Client.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:RetailPOS.Client.ViewModels"
    mc:Ignorable="d"
    Background="#F8FAFC">

    <Grid RowSpacing="16" Padding="24">
        <Grid.RowDefinitions>
            <!-- 0: Header & Controls -->
            <RowDefinition Height="Auto" />
            <!-- 1: Notification & Feedback InfoBars -->
            <RowDefinition Height="Auto" />
            <!-- 2: Module Tab Selection Bar -->
            <RowDefinition Height="Auto" />
            <!-- 3: Active Report Workspace Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0. Header & Controls -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24, 18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Role Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Border Width="44" Height="44" Background="#EFF6FF" CornerRadius="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9F9;" FontSize="22" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Reports &amp; Analytics Workspace" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                            <Border Background="{x:Bind RoleBadgeBackground, Mode=OneWay}" CornerRadius="12" Padding="8, 2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind RoleBadgeText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind RoleBadgeForeground, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Daily sales, shift reconciliations, GST taxes, product margins, and cashier performance" FontSize="12" Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Date Preset & Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Date Presets ComboBox -->
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedDatePresetIndex, Mode=TwoWay}"
                              Width="150"
                              AutomationProperties.AutomationId="ReportsDatePresetCombo"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="Today" />
                        <ComboBoxItem Content="Yesterday" />
                        <ComboBoxItem Content="Last 7 Days" />
                        <ComboBoxItem Content="This Month" />
                        <ComboBoxItem Content="Last Month" />
                        <ComboBoxItem Content="Custom Range" />
                    </ComboBox>

                    <!-- Custom Date Pickers (visible only when Custom is chosen) -->
                    <CalendarDatePicker Date="{x:Bind ViewModel.CustomStartDate, Mode=TwoWay}"
                                        PlaceholderText="From Date"
                                        DateFormat="{}{day.integer}/{month.integer}/{year.full}"
                                        Visibility="{x:Bind CustomDateVisibility, Mode=OneWay}"
                                        AutomationProperties.AutomationId="ReportsStartDatePicker"
                                        Width="130"
                                        VerticalAlignment="Center" />
                    <CalendarDatePicker Date="{x:Bind ViewModel.CustomEndDate, Mode=TwoWay}"
                                        PlaceholderText="To Date"
                                        DateFormat="{}{day.integer}/{month.integer}/{year.full}"
                                        Visibility="{x:Bind CustomDateVisibility, Mode=OneWay}"
                                        AutomationProperties.AutomationId="ReportsEndDatePicker"
                                        Width="130"
                                        VerticalAlignment="Center" />

                    <!-- Refresh Button -->
                    <Button Content="Refresh (F5)"
                            Click="OnRefreshClicked"
                            AutomationProperties.AutomationId="ReportsRefreshButton"
                            VerticalAlignment="Center">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                    </Button>

                    <!-- Export CSV Button -->
                    <Button Content="Export CSV"
                            Click="OnExportCsvClicked"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="ReportsExportCsvButton"
                            VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Notification & Feedback InfoBars -->
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="{x:Bind HasErrorMessage, Mode=OneWay}"
                     Severity="Error"
                     Title="Report Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     AutomationProperties.AutomationId="ReportsErrorInfoBar" />

            <InfoBar IsOpen="{x:Bind HasStatusMessage, Mode=OneWay}"
                     Severity="Success"
                     Title="Success"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     AutomationProperties.AutomationId="ReportsStatusInfoBar" />

            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind LoadingVisibility, Mode=OneWay}"
                         AutomationProperties.AutomationId="ReportsProgressBar" />
        </StackPanel>

        <!-- 2. Module Tab Selection Bar -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8, 6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- Tab 0: Daily Sales (Owner/Admin/Manager) -->
                    <Button Content="Daily Sales"
                            Click="OnTab0Clicked"
                            Background="{x:Bind Tab0Background, Mode=OneWay}"
                            Foreground="{x:Bind Tab0Foreground, Mode=OneWay}"
                            FontWeight="{x:Bind Tab0FontWeight, Mode=OneWay}"
                            Visibility="{x:Bind DailySalesTabHeaderVisibility, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="16, 8"
                            AutomationProperties.AutomationId="TabDailySales" />

                    <!-- Tab 1: Shift Reconciliation (Owner/Admin/Manager) -->
                    <Button Content="Shift Reconciliation"
                            Click="OnTab1Clicked"
                            Background="{x:Bind Tab1Background, Mode=OneWay}"
                            Foreground="{x:Bind Tab1Foreground, Mode=OneWay}"
                            FontWeight="{x:Bind Tab1FontWeight, Mode=OneWay}"
                            Visibility="{x:Bind ShiftTabHeaderVisibility, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="16, 8"
                            AutomationProperties.AutomationId="TabShiftReconciliation" />

                    <!-- Tab 2: GST Tax Summary (Owner/Admin/Manager) -->
                    <Button Content="GST Tax Summary"
                            Click="OnTab2Clicked"
                            Background="{x:Bind Tab2Background, Mode=OneWay}"
                            Foreground="{x:Bind Tab2Foreground, Mode=OneWay}"
                            FontWeight="{x:Bind Tab2FontWeight, Mode=OneWay}"
                            Visibility="{x:Bind TaxTabHeaderVisibility, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="16, 8"
                            AutomationProperties.AutomationId="TabTaxSummary" />

                    <!-- Tab 3: Product Performance (Owner/Admin/Manager) -->
                    <Button Content="Product Performance"
                            Click="OnTab3Clicked"
                            Background="{x:Bind Tab3Background, Mode=OneWay}"
                            Foreground="{x:Bind Tab3Foreground, Mode=OneWay}"
                            FontWeight="{x:Bind Tab3FontWeight, Mode=OneWay}"
                            Visibility="{x:Bind ProductsTabHeaderVisibility, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="16, 8"
                            AutomationProperties.AutomationId="TabProductPerformance" />

                    <!-- Tab 4: Cashier Performance (All Authorized) -->
                    <Button Content="Cashier Performance"
                            Click="OnTab4Clicked"
                            Background="{x:Bind Tab4Background, Mode=OneWay}"
                            Foreground="{x:Bind Tab4Foreground, Mode=OneWay}"
                            FontWeight="{x:Bind Tab4FontWeight, Mode=OneWay}"
                            Visibility="{x:Bind CashierTabHeaderVisibility, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="16, 8"
                            AutomationProperties.AutomationId="TabCashierPerformance" />

                    <!-- Tab 5: Terminal Snapshot (All Authorized) -->
                    <Button Content="Terminal Snapshot"
                            Click="OnTab5Clicked"
                            Background="{x:Bind Tab5Background, Mode=OneWay}"
                            Foreground="{x:Bind Tab5Foreground, Mode=OneWay}"
                            FontWeight="{x:Bind Tab5FontWeight, Mode=OneWay}"
                            Visibility="{x:Bind TerminalTabHeaderVisibility, Mode=OneWay}"
                            CornerRadius="8"
                            Padding="16, 8"
                            AutomationProperties.AutomationId="TabTerminalSnapshot" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 3. Active Report Workspace Content -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <!-- ================= TAB 0: DAILY SALES ================= -->
                <StackPanel Visibility="{x:Bind Tab0ContentVisibility, Mode=OneWay}" Spacing="16" AutomationProperties.AutomationId="DailySalesPanel">
                    <!-- Key Figures Metric Cards -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Gross Sales -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16, 14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="GROSS SALES" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                                <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedGrossSales, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" AutomationProperties.AutomationId="DailyGrossSalesText" />
                                <TextBlock Text="{x:Bind InvoicesCountSummary, Mode=OneWay}" FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <!-- Net Revenue -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16, 14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="NET REVENUE" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                                <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedNetRevenue, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#15803D" AutomationProperties.AutomationId="DailyNetRevenueText" />
                                <TextBlock Text="After discounts &amp; refunds" FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <!-- Taxable Subtotal -->
                        <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16, 14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="TAXABLE SUB-TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                                <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedTaxableSubtotal, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="{x:Bind ItemsSoldSummary, Mode=OneWay}" FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <!-- Total Tax -->
                        <Border Grid.Column="3" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16, 14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="TOTAL GST TAX" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                                <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedTotalTax, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#2563EB" />
                                <TextBlock Text="CGST + SGST + IGST" FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <!-- Refunds & Voids -->
                        <Border Grid.Column="4" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16, 14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="REFUNDS &amp; VOIDS" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                                <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedTotalRefunds, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#DC2626" />
                                <TextBlock Text="{x:Bind RefundsSummary, Mode=OneWay}" FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Breakdown: Financial Summary & Tender Split -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Financial Overview -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="FINANCIAL RECONCILIATION SUMMARY" FontSize="12" FontWeight="Bold" Foreground="#64748B" />

                                <Grid Padding="0, 4">
                                    <TextBlock Text="Gross Subtotal" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedGrossSubtotal, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0F172A" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="Line Discounts" Foreground="#64748B" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedTotalLineDiscounts, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#DC2626" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="Invoice / Bill Discounts" Foreground="#64748B" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedTotalInvoiceDiscounts, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#DC2626" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="Taxable Subtotal" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedTaxableSubtotal, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0F172A" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="Total GST Tax" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedTotalTax, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#2563EB" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="Rounding Adjustment" Foreground="#64748B" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedRoundingAdjustment, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#64748B" />
                                </Grid>
                                <Border Height="1" Background="#E2E8F0" Margin="0, 4" />
                                <Grid Padding="0, 4">
                                    <TextBlock Text="Net Sales Revenue" FontWeight="Bold" Foreground="#0F172A" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedNetRevenue, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#15803D" FontSize="16" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Right: Payment Tenders Split -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="PAYMENT TENDERS COLLECTED" FontSize="12" FontWeight="Bold" Foreground="#64748B" />

                                <Grid Padding="0, 4">
                                    <TextBlock Text="Cash" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedCash, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0F172A" AutomationProperties.AutomationId="TenderCashText" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="Card (Debit / Credit)" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedCard, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0F172A" AutomationProperties.AutomationId="TenderCardText" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="UPI (QR / App)" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedUpi, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0F172A" AutomationProperties.AutomationId="TenderUpiText" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="Bank Transfer (NEFT/RTGS/IMPS)" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedBankTransfer, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0F172A" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="Cheque" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedCheque, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0F172A" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="Customer Store Credit" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedCredit, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0F172A" />
                                </Grid>
                                <Border Height="1" Background="#E2E8F0" Margin="0, 4" />
                                <Grid Padding="0, 4">
                                    <TextBlock Text="Total Tenders" FontWeight="Bold" Foreground="#0F172A" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.DailySales.FormattedTotalTenders, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#2563EB" FontSize="16" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Hourly Sales Distribution -->
                    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="HOURLY SALES VELOCITY" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                            <ListView ItemsSource="{x:Bind ViewModel.DailySales.HourlyDistribution, Mode=OneWay}" SelectionMode="None">
                                <ListView.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12, 8" Background="#F1F5F9" CornerRadius="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Time Window" FontWeight="Bold" Foreground="#475569" />
                                            <TextBlock Grid.Column="1" Text="Bills Count" FontWeight="Bold" Foreground="#475569" />
                                            <TextBlock Grid.Column="2" Text="Net Sales Amount" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.HeaderTemplate>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HourlySalesItemViewModel">
                                        <Grid Padding="12, 6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind HourDisplay}" Foreground="#334155" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind InvoiceCount}" Foreground="#64748B" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedNetSales}" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= TAB 1: SHIFT RECONCILIATION ================= -->
                <StackPanel Visibility="{x:Bind Tab1ContentVisibility, Mode=OneWay}" Spacing="16" AutomationProperties.AutomationId="ShiftReconciliationPanel">
                    <!-- Terminal & Session Context Header -->
                    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ShiftTerminalHeader, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                                    <Border Background="#DCFCE7" CornerRadius="12" Padding="8, 2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.Shift.SessionStatus, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ShiftCashierAndStartTime, Mode=OneWay}" FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                            <!-- X/Z Slips Management Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Content="Preview X-Report"
                                        Click="OnPreviewXReportClicked"
                                        AutomationProperties.AutomationId="PreviewXReportButton" />
                                <Button Content="Preview Z-Report"
                                        Click="OnPreviewZReportClicked"
                                        AutomationProperties.AutomationId="PreviewZReportButton" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Two Columns: Cash Formula on Left, Counted Discrepancy on Right -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Authoritative Cash Formula -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="DRAWER CASH RECONCILIATION FORMULA" FontSize="12" FontWeight="Bold" Foreground="#64748B" />

                                <Grid Padding="0, 4">
                                    <TextBlock Text="Opening Float" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.Shift.FormattedOpeningFloat, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#0F172A" AutomationProperties.AutomationId="ShiftOpeningFloatText" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="(+) Cash Sales Received" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.Shift.FormattedTotalCashSales, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#15803D" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="(+) Customer Cash Repayments" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.Shift.FormattedTotalCashRepayments, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#15803D" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="(+) Cash Pay-Ins (Float Additions)" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.Shift.FormattedTotalPayIns, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#15803D" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="(-) Cash Refunds Given" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.Shift.FormattedTotalCashRefunds, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#DC2626" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="(-) Cash Pay-Outs (Expenses)" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.Shift.FormattedTotalPayOuts, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#DC2626" />
                                </Grid>
                                <Grid Padding="0, 4">
                                    <TextBlock Text="(-) Safe Cash Drops" Foreground="#334155" />
                                    <TextBlock Text="{x:Bind ViewModel.Shift.FormattedTotalCashDrops, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#DC2626" />
                                </Grid>
                                <Border Height="1" Background="#E2E8F0" Margin="0, 4" />
                                <Grid Padding="0, 4">
                                    <TextBlock Text="(=) Expected In Drawer" FontWeight="Bold" Foreground="#0F172A" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.Shift.FormattedCurrentExpectedCash, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#2563EB" FontSize="16" AutomationProperties.AutomationId="ShiftExpectedCashText" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Right: Discrepancy & Counted Calculator -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="PHYSICAL CASH COUNT &amp; AUDIT" FontSize="12" FontWeight="Bold" Foreground="#64748B" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Actual Counted Cash in Drawer (₹)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                    <TextBox Text="{x:Bind ViewModel.Shift.CountedCashInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="e.g. 12500 or 12500.50"
                                             AutomationProperties.AutomationId="CountedCashTextBox" />
                                </StackPanel>

                                <!-- Discrepancy Display Card -->
                                <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                                    <Grid>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="AUDIT DISCREPANCY" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                                            <TextBlock Text="{x:Bind ViewModel.Shift.FormattedDiscrepancy, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{x:Bind DiscrepancyBrush, Mode=OneWay}" AutomationProperties.AutomationId="ShiftDiscrepancyText" />
                                            <TextBlock Text="{x:Bind ViewModel.Shift.DiscrepancyStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind DiscrepancyBrush, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

