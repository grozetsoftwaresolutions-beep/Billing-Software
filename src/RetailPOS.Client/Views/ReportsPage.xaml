                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Timestamp" FontWeight="Bold" Foreground="#475569" />
                                            <TextBlock Grid.Column="1" Text="Type" FontWeight="Bold" Foreground="#475569" />
                                            <TextBlock Grid.Column="2" Text="Reference #" FontWeight="Bold" Foreground="#475569" />
                                            <TextBlock Grid.Column="3" Text="Cashier" FontWeight="Bold" Foreground="#475569" />
                                            <TextBlock Grid.Column="4" Text="Amount" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.HeaderTemplate>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecentTerminalTransactionItemViewModel">
                                        <Grid Padding="12, 6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind FormattedTimestamp}" Foreground="#64748B" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind TransactionType}" FontWeight="SemiBold" Foreground="#334155" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ReferenceNumber}" Foreground="#0F172A" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind CashierName}" Foreground="#64748B" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind FormattedAmount}" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
