<Page
    x:Class="RetailPOS.Client.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:RetailPOS.Client.ViewModels"
    xmlns:local="using:RetailPOS.Client.Views"
    mc:Ignorable="d"
    Background="#F1F5F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Application Shell Header -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20, 14" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Branding & Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="#1E3E62" CornerRadius="8" VerticalAlignment="Center">
                        <TextBlock Text="G" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.AppTitle, Mode=OneWay}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Background="#1E293B" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                <TextBlock Text="POS CLIENT" Foreground="#94A3B8" FontSize="9" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Foreground="#94A3B8" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: Current Module Indicator -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="16" Padding="14, 5" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7BF;" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentModuleName, Mode=OneWay}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Session & Status Badges + Lock/Logout Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Session Status -->
                    <Border Background="#1E293B" CornerRadius="14" Padding="12,5" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SessionStatusText, Mode=OneWay}" Foreground="#CBD5E1" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Lock Session Button (Active when authenticated) -->
                    <Button
                        x:Name="HeaderLockButton"
                        Visibility="{x:Bind AuthenticatedVisibility, Mode=OneWay}"
                        Click="OnHeaderLockClicked"
                        ToolTipService.ToolTip="Lock Terminal (Preserves active session)"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="#F59E0B" />
                            <TextBlock Text="Lock" Foreground="#F8FAFC" FontSize="11" FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <!-- Log Out Button (Active when authenticated) -->
                    <Button
                        x:Name="HeaderLogoutButton"
                        Visibility="{x:Bind AuthenticatedVisibility, Mode=OneWay}"
                        Click="OnHeaderLogoutClicked"
                        ToolTipService.ToolTip="Log Out"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7E8;" FontSize="11" Foreground="#EF4444" />
                            <TextBlock Text="Log Out" Foreground="#F8FAFC" FontSize="11" FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <!-- Server Connection Status Pill -->
                    <Border Background="#1E293B" CornerRadius="14" Padding="12,5" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{x:Bind ServerStatusDotBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.ServerStatusText, Mode=OneWay}" Foreground="#F8FAFC" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Terminal Status Pill -->
                    <Border Background="#1E293B" CornerRadius="14" Padding="12,5" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{x:Bind TerminalStatusDotBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.TerminalStatusText, Mode=OneWay}" Foreground="#F8FAFC" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Navigation View (When Authenticated) -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            Visibility="{x:Bind AuthenticatedVisibility, Mode=OneWay}"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            SelectionChanged="OnNavSelectionChanged"
            Loaded="OnNavViewLoaded"
            Background="#F8FAFC">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavHome" Content="Home" Tag="Home" Icon="Home" />
                <NavigationViewItem x:Name="NavPos" Content="POS &amp; Billing" Tag="POS" Icon="Shop" />
                <NavigationViewItem x:Name="NavSalesHistory" Content="Sales History" Tag="SalesHistory" Icon="Clock" />
                <NavigationViewItem x:Name="NavCustomers" Content="Customers &amp; Credit" Tag="Customers" Icon="Contact" />
                <NavigationViewItem x:Name="NavProducts" Content="Products &amp; Stock" Tag="Products" Icon="AllApps" />
                <NavigationViewItem x:Name="NavReports" Content="Reports" Tag="Reports" Icon="Document" />
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Frame x:Name="ContentFrame" />
            </NavigationView.Content>
        </NavigationView>

        <!-- Main Body: Login Host Frame (When Unauthenticated) -->
        <Frame
            x:Name="LoginHostFrame"
            Grid.Row="1"
            Visibility="{x:Bind UnauthenticatedVisibility, Mode=OneWay}" />

        <!-- Bottom Application Status Bar -->
        <Border Grid.Row="2" Background="#E2E8F0" Padding="20, 8" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="© Grozet Software Solutions. All rights reserved." Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Server Endpoint:" Foreground="#64748B" FontSize="11" />
                    <TextBlock Text="{x:Bind ViewModel.ServerEndpoint, Mode=OneWay}" Foreground="#334155" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="Windows 10/11 x64 • .NET 10 • Presentation Client Only" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Lock Modal Overlay (Spanning Full Window, Topmost Z-Index) -->
        <local:LockOverlayControl
            x:Name="LockOverlay"
            Grid.Row="0"
            Grid.RowSpan="3"
            Canvas.ZIndex="999"
            Visibility="{x:Bind LockOverlayVisibility, Mode=OneWay}" />
    </Grid>
</Page>
