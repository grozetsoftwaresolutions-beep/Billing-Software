<Page
    x:Class="RetailPOS.Client.Views.PosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:RetailPOS.Client.ViewModels"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="#F8FAFC">

    <Grid>
        <!-- Main Dual-Pane POS Layout -->
        <Grid Padding="20" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Top Search & Command Bar -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16, 12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="OnBackToHomeClicked"
                                ToolTipService.ToolTip="Return to Home / Dashboard"
                                Background="#F1F5F9"
                                Foreground="#1E3E62"
                                FontWeight="SemiBold"
                                Padding="10, 6"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE80F;" FontSize="14" Foreground="#1E3E62" />
                                <TextBlock Text="Home" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Border Width="36" Height="36" Background="#EFF6FF" CornerRadius="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7BF;" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox"
                                 PlaceholderText="Search product by Name, SKU, or Barcode... (F2)"
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnSearchBoxKeyDown"
                                 FontSize="14"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <Button Grid.Column="2"
                            Content="Search"
                            Command="{x:Bind ViewModel.SearchProductsCommand}"
                            Background="#2563EB"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="16, 8" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="F2 Search"
                                Click="OnF2SearchClicked"
                                Background="#F1F5F9"
                                Foreground="#334155"
                                FontWeight="Bold"
                                FontSize="11"
                                Padding="10, 6"
                                CornerRadius="6"
                                ToolTipService.ToolTip="Focus search box (F2)" />
                        <Button Content="F4 New Bill"
                                Click="OnF4NewBillClicked"
                                Background="#F1F5F9"
                                Foreground="#334155"
                                FontWeight="Bold"
                                FontSize="11"
                                Padding="10, 6"
                                CornerRadius="6"
                                ToolTipService.ToolTip="Start fresh bill (F4)" />
                        <Button Content="F12 Checkout"
                                Click="OnF12CheckoutClicked"
                                Background="#15803D"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="11"
                                Padding="10, 6"
                                CornerRadius="6"
                                ToolTipService.ToolTip="Pay and checkout (F12)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Dual Pane Workspace -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65*" />
                    <ColumnDefinition Width="35*" />
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Cart & Search Dropdown -->
                <Grid Grid.Column="0">
                    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Cart Table Header -->
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0, 0, 0, 1" Padding="16, 10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="ITEM / PRODUCT" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock Grid.Column="1" Text="UNIT" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="QUANTITY" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="PRICE" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="TAX" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="TOTAL" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="" />
                                </Grid>
                            </Border>

                            <!-- Cart Items List -->
                            <ListView Grid.Row="1"
                                      ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedCartItem, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CartItemViewModel">
                                        <Grid ColumnSpacing="8" Padding="16, 8" BorderBrush="#F1F5F9" BorderThickness="0, 0, 0, 1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Name & SKU -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ProductName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Sku, Mode=OneWay}" FontSize="11" Foreground="#64748B" />
                                            </StackPanel>

                                            <!-- Unit -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind UnitCode, Mode=OneWay}" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <!-- Quantity Controls -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="-" Click="OnDecrementQuantityClicked" Tag="{x:Bind}" Width="28" Height="28" Padding="0" Background="#F1F5F9" CornerRadius="4" />
                                                <TextBlock Text="{x:Bind FormattedQuantity, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Width="40" TextAlignment="Center" />
                                                <Button Content="+" Click="OnIncrementQuantityClicked" Tag="{x:Bind}" Width="28" Height="28" Padding="0" Background="#F1F5F9" CornerRadius="4" />
                                            </StackPanel>

                                            <!-- Unit Price -->
                                            <TextBlock Grid.Column="3" Text="{x:Bind FormattedUnitPrice, Mode=OneWay}" FontSize="13" Foreground="#334155" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <!-- Tax -->
                                            <TextBlock Grid.Column="4" Text="{x:Bind FormattedTax, Mode=OneWay}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <!-- Line Total -->
                                            <TextBlock Grid.Column="5" Text="{x:Bind FormattedLineTotal, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <!-- Delete Button -->
                                            <Button Grid.Column="6" Click="OnRemoveItemClicked" Tag="{x:Bind}" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#EF4444" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Search Results Overlay Popup -->
                    <Border Visibility="{x:Bind SearchResultsVisibility, Mode=OneWay}"
                            Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1"
                            VerticalAlignment="Top" Margin="0, 4, 0, 0" MaxHeight="300">
                        <ListView ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSearchResult, Mode=TwoWay}"
                                  ItemClick="OnSearchResultItemClicked"
                                  IsItemClickEnabled="True">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProductSearchResultViewModel">
                                    <Grid ColumnSpacing="12" Padding="12, 8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                            <TextBlock Text="{x:Bind Sku}" FontSize="11" Foreground="#64748B" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{x:Bind FormattedPrice}" FontSize="13" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="#ECFDF5" CornerRadius="4" Padding="6, 2" VerticalAlignment="Center">
                                            <TextBlock Text="IN STOCK" FontSize="10" FontWeight="Bold" Foreground="#059669" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>

                <!-- Right Pane: Summary & Checkout Actions -->
                <Grid Grid.Column="1">
                    <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Operator & Terminal Header -->
                            <Grid Grid.Row="0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="BILL SUMMARY" FontSize="12" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="50" />
                                    <TextBlock Text="{x:Bind ViewModel.OperatorDisplay, Mode=OneWay}" FontSize="12" Foreground="#334155" />
                                </StackPanel>
                            </Grid>

                            <!-- Financial Breakdown -->
                            <StackPanel Grid.Row="1" Spacing="10" VerticalAlignment="Top">
                                <Grid>
                                    <TextBlock Text="Items / Total Units" FontSize="13" Foreground="#64748B" />
                                    <TextBlock Text="{x:Bind ViewModel.ItemCount, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>

                                <Border Height="1" Background="#F1F5F9" />

                                <Grid>
                                    <TextBlock Text="Gross Subtotal" FontSize="13" Foreground="#64748B" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedGrossSubtotal, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid>
                                    <TextBlock Text="Discounts" FontSize="13" Foreground="#64748B" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedTotalDiscounts, Mode=OneWay}" FontSize="13" Foreground="#EF4444" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid>
                                    <TextBlock Text="Taxable Amount" FontSize="13" Foreground="#64748B" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedTaxableSubtotal, Mode=OneWay}" FontSize="13" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid>
                                    <TextBlock Text="Taxes (GST)" FontSize="13" Foreground="#64748B" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedTotalTax, Mode=OneWay}" FontSize="13" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid>
                                    <TextBlock Text="Cash Rounding" FontSize="13" Foreground="#64748B" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedRounding, Mode=OneWay}" FontSize="13" HorizontalAlignment="Right" />
                                </Grid>

                                <Border Height="1" Background="#E2E8F0" Margin="0, 6" />

                                <!-- Grand Total -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="TOTAL PAYABLE" FontSize="11" FontWeight="Bold" Foreground="#15803D" CharacterSpacing="50" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedFinalPayable, Mode=OneWay}" FontSize="32" FontWeight="Bold" Foreground="#15803D" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Primary Action Buttons -->
                            <StackPanel Grid.Row="2" Spacing="10">
                                <Button Content="CLEAR / NEW BILL (F4)"
                                        Command="{x:Bind ViewModel.NewBillCommand}"
                                        HorizontalAlignment="Stretch"
                                        Background="#F1F5F9"
                                        Foreground="#475569"
                                        FontWeight="SemiBold"
                                        Padding="0, 10" />

                                <Button x:Name="CheckoutButton"
                                        Content="PAY / CHECKOUT (F12)"
                                        Command="{x:Bind ViewModel.OpenPaymentCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanCheckout, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        Background="#15803D"
                                        Foreground="White"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Padding="0, 14"
                                        CornerRadius="8" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. Bottom Status Bar -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14, 8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" Foreground="#475569" />
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444" Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TerminalDisplay, Mode=OneWay}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Payment Dialog Overlay -->
        <Grid Visibility="{x:Bind PaymentOverlayVisibility, Mode=OneWay}" Background="#90000000">
            <Border Background="White" CornerRadius="12" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel Spacing="20">
                    <Grid>
                        <TextBlock Text="COMPLETE PAYMENT" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                        <Button Content="✕" Click="OnClosePaymentClicked" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" FontSize="16" />
                    </Grid>

                    <Border Background="#F0FDF4" CornerRadius="8" Padding="16">
                        <Grid>
                            <TextBlock Text="Total Payable:" FontSize="14" Foreground="#166534" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.FormattedFinalPayable, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Payment Method Toggle -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="SELECT PAYMENT METHOD" FontSize="11" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="50" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Cash" Click="OnSelectCashClicked"
                                    HorizontalAlignment="Stretch" Padding="0, 12" FontWeight="SemiBold"
                                    Background="{x:Bind CashTabBackground, Mode=OneWay}"
                                    Foreground="{x:Bind CashTabForeground, Mode=OneWay}" />

                            <Button Grid.Column="1" Content="Card" Click="OnSelectCardClicked"
                                    HorizontalAlignment="Stretch" Padding="0, 12" FontWeight="SemiBold"
                                    Background="{x:Bind CardTabBackground, Mode=OneWay}"
                                    Foreground="{x:Bind CardTabForeground, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <!-- Cash Inputs -->
                    <StackPanel Visibility="{x:Bind CashFormVisibility, Mode=OneWay}" Spacing="12">
                        <!-- Quick Cash Presets -->
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Exact" Click="OnPresetClicked" Tag="Exact" HorizontalAlignment="Stretch" Padding="0, 6" FontSize="11" />
                            <Button Grid.Column="1" Content="₹100" Click="OnPresetClicked" Tag="100" HorizontalAlignment="Stretch" Padding="0, 6" FontSize="11" />
                            <Button Grid.Column="2" Content="₹200" Click="OnPresetClicked" Tag="200" HorizontalAlignment="Stretch" Padding="0, 6" FontSize="11" />
                            <Button Grid.Column="3" Content="₹500" Click="OnPresetClicked" Tag="500" HorizontalAlignment="Stretch" Padding="0, 6" FontSize="11" />
                            <Button Grid.Column="4" Content="₹1000" Click="OnPresetClicked" Tag="1000" HorizontalAlignment="Stretch" Padding="0, 6" FontSize="11" />
                        </Grid>

                        <TextBox Header="Cash Tendered (₹)"
                                 Text="{x:Bind ViewModel.TenderedAmountRupees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="16" />

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="Change Due:" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedChangeDue, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Card Inputs -->
                    <StackPanel Visibility="{x:Bind CardFormVisibility, Mode=OneWay}" Spacing="8">
                        <TextBox Header="Authorization / Reference Number (Optional)"
                                 Text="{x:Bind ViewModel.CardReferenceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Spacing="10" Margin="0, 8, 0, 0">
                        <Button Content="CONFIRM &amp; COMPLETE SALE"
                                Command="{x:Bind ViewModel.ExecuteCheckoutCommand}"
                                HorizontalAlignment="Stretch"
                                Background="#15803D"
                                Foreground="White"
                                FontSize="15"
                                FontWeight="Bold"
                                Padding="0, 12"
                                CornerRadius="8" />

                        <Button Content="Cancel" Click="OnClosePaymentClicked"
                                HorizontalAlignment="Stretch"
                                Background="#F1F5F9"
                                Foreground="#64748B"
                                Padding="0, 8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Checkout Success Dialog Overlay -->
        <Grid Visibility="{x:Bind CheckoutSuccessVisibility, Mode=OneWay}" Background="#90000000">
            <Border Background="White" CornerRadius="12" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" Background="#DCFCE7" CornerRadius="28" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="28" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="Sale Completed Successfully!" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
                        <TextBlock Text="Authoritative Invoice Number:" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.LastCompletedInvoiceNumber, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#1E3E62" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Button Content="Start Next Bill (F4)"
                            Click="OnDismissSuccessClicked"
                            HorizontalAlignment="Stretch"
                            Background="#15803D"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="24, 12"
                            CornerRadius="8" />

                    <Button x:Name="ViewInSalesHistoryBtn"
                            Content="View in Sales History"
                            Click="OnViewInSalesHistoryClicked"
                            Visibility="{x:Bind ViewInSalesHistoryVisibility, Mode=OneWay}"
                            HorizontalAlignment="Stretch"
                            Background="#F1F5F9"
                            Foreground="#1E3E62"
                            FontWeight="SemiBold"
                            Padding="24, 10"
                            CornerRadius="8"
                            AutomationProperties.AutomationId="ViewInSalesHistoryButton" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
