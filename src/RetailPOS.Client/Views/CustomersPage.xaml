<Page
    x:Class="RetailPOS.Client.Views.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:RetailPOS.Client.ViewModels"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="#F8FAFC">

    <Grid>
        <!-- Main Workspace Content -->
        <Grid RowSpacing="16" Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Header Card -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24, 18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Width="42" Height="42" Background="#EFF6FF" CornerRadius="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Customers &amp; Store Credit" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="Customer accounts, credit limits, transaction ledgers, and safe debt repayment recording" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="+ New Customer"
                                Click="OnNewCustomerClicked"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind CanCreateCustomerVisibility, Mode=OneWay}"
                                AutomationProperties.AutomationId="NewCustomerButton" />
                        <Button Content="Refresh (F5)"
                                Click="OnRefreshClicked"
                                AutomationProperties.AutomationId="RefreshCustomersButton">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F5" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Notifications, Warnings & Progress -->
            <StackPanel Grid.Row="1" Spacing="8">
                <InfoBar IsOpen="{x:Bind HasErrorMessage, Mode=OneWay}"
                         Severity="Error"
                         Title="Customer Workspace Notice"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         IsClosable="True"
                         CloseButtonClick="OnDismissError" />

                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" Height="3" />
            </StackPanel>

            <!-- 3. Master-Detail Workspace -->
            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT PANE: Customer Directory & Search -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Search and Filter Bar -->
                        <Border Grid.Row="0" Background="#F8FAFC" Padding="14, 12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0"
                                         PlaceholderText="Search by name, phone, email..."
                                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnSearchBoxKeyDown"
                                         AutomationProperties.AutomationId="CustomerSearchBox" />

                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              SelectedIndex="{x:Bind ViewModel.ActiveFilterIndex, Mode=TwoWay}"
                                              SelectionChanged="OnFilterChanged"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.AutomationId="StatusFilterComboBox">
                                        <ComboBoxItem Content="All Customers" />
                                        <ComboBoxItem Content="Active Only" />
                                        <ComboBoxItem Content="Inactive Only" />
                                    </ComboBox>

                                    <Button Grid.Column="1"
                                            Content="Search"
                                            Click="OnSearchClicked"
                                            AutomationProperties.AutomationId="SearchButton" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Customer List View -->
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  AutomationProperties.AutomationId="CustomersListView">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomerSummaryItemViewModel">
                                    <Grid Padding="12, 10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" AutomationProperties.AutomationId="{x:Bind Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Circular Avatar -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#EFF6FF" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind InitialLetter}" FontWeight="Bold" Foreground="#2563EB" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" Margin="10, 0, 0, 0" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Phone}" FontSize="12" Foreground="#64748B" />
                                        </StackPanel>

                                        <!-- Status & Balances -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                                            <Border Background="{x:Bind StatusBadgeBackground}" CornerRadius="4" Padding="6, 2" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind StatusBadgeForeground}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind OutstandingCreditFormatted}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E11D48"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{x:Bind HasDebt}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty State in List -->
                        <StackPanel Grid.Row="1"
                                    Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="10"
                                    Padding="24">
                            <FontIcon Glyph="&#xE77B;" FontSize="36" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                            <TextBlock Text="No customers found" FontSize="15" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" />
                            <TextBlock Text="Try adjusting your search criteria or register a new customer." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>

                        <!-- Pagination Footer -->
                        <Border Grid.Row="2" Background="#F8FAFC" Padding="12, 10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="◀ Prev"
                                        Click="OnPrevPageClicked"
                                        IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                                        AutomationProperties.AutomationId="PrevPageButton" />

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.PaginationSummary, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="PaginationSummaryText" />

                                <Button Grid.Column="2"
                                        Content="Next ▶"
                                        Click="OnNextPageClicked"
                                        IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                                        AutomationProperties.AutomationId="NextPageButton" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT PANE: Master-Detail Account Workspace -->
                <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <!-- 1. No Customer Selected State -->
                        <StackPanel Visibility="{x:Bind NoCustomerSelectedVisibility, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="12"
                                    Padding="32"
                                    AutomationProperties.AutomationId="NoCustomerSelectedPanel">
                            <Border Width="64" Height="64" Background="#F1F5F9" CornerRadius="32" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE77B;" FontSize="28" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select a Customer" FontSize="18" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" />
                            <TextBlock Text="Choose a customer from the directory to view credit balances, transaction ledgers, payment history, and record repayments."
                                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" />
                        </StackPanel>

                        <!-- 2. Customer Detail Container -->
                        <Grid Visibility="{x:Bind CustomerSelectedVisibility, Mode=OneWay}" Padding="20" RowSpacing="16" AutomationProperties.AutomationId="CustomerDetailContainer">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Profile Summary & Action Buttons Header -->
                            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Customer Profile Info -->
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.Name, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" AutomationProperties.AutomationId="DetailCustomerName" />
                                            <Border Background="{x:Bind ViewModel.SelectedCustomer.StatusBadgeBackground, Mode=OneWay}" CornerRadius="4" Padding="6, 2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.StatusText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind ViewModel.SelectedCustomer.StatusBadgeForeground, Mode=OneWay}" AutomationProperties.AutomationId="DetailStatusBadge" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <TextBlock Text="{x:Bind PhoneDisplay, Mode=OneWay}" FontSize="13" Foreground="#475569" AutomationProperties.AutomationId="DetailCustomerPhone" />
                                            <TextBlock Text="{x:Bind EmailDisplay, Mode=OneWay}" FontSize="13" Foreground="#475569" AutomationProperties.AutomationId="DetailCustomerEmail" />
                                            <TextBlock Text="{x:Bind GstinDisplay, Mode=OneWay}" FontSize="13" Foreground="#475569" AutomationProperties.AutomationId="DetailCustomerGstin" />
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind AddressDisplay, Mode=OneWay}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="DetailCustomerAddress" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Record Repayment"
                                                Click="OnRecordRepaymentClicked"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Visibility="{x:Bind CanRepayVisibility, Mode=OneWay}"
                                                AutomationProperties.AutomationId="RecordRepaymentButton" />

                                        <Button Content="Edit Profile"
                                                Click="OnEditProfileClicked"
                                                Visibility="{x:Bind CanEditVisibility, Mode=OneWay}"
                                                AutomationProperties.AutomationId="EditProfileButton" />

                                        <Button Content="Credit Limit"
                                                Click="OnAdjustCreditLimitClicked"
                                                Visibility="{x:Bind CanManageCreditLimitVisibility, Mode=OneWay}"
                                                AutomationProperties.AutomationId="AdjustCreditLimitButton" />

                                        <Button Content="{x:Bind ToggleStatusButtonText, Mode=OneWay}"
                                                Click="OnToggleStatusClicked"
                                                Visibility="{x:Bind CanChangeStatusVisibility, Mode=OneWay}"
                                                AutomationProperties.AutomationId="ToggleStatusButton" />

                                        <Button Content="Refresh"
                                                Click="OnRefreshAccountClicked"
                                                AutomationProperties.AutomationId="RefreshAccountButton" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Server-Authoritative Financial Cards (Strictly 3 Cards: Debt, Store Credit, Limit) -->
                            <Grid Grid.Row="1" ColumnSpacing="12" AutomationProperties.AutomationId="FinancialCardsContainer">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Outstanding Debt -->
                                <Border Grid.Column="0" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="8" Padding="16, 12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="OUTSTANDING DEBT" FontSize="11" FontWeight="Bold" Foreground="#BE123C" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.OutstandingCreditFormatted, Mode=OneWay}"
                                                   FontSize="22" FontWeight="Bold" Foreground="#E11D48"
                                                   AutomationProperties.AutomationId="OutstandingDebtDisplay" />
                                        <TextBlock Text="Server-authoritative unpaid balance" FontSize="11" Foreground="#9F1239" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Prepaid Store Credit -->
                                <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="16, 12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="PREPAID STORE CREDIT" FontSize="11" FontWeight="Bold" Foreground="#047857" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.CreditBalanceFormatted, Mode=OneWay}"
                                                   FontSize="22" FontWeight="Bold" Foreground="#059669"
                                                   AutomationProperties.AutomationId="StoreCreditDisplay" />
                                        <TextBlock Text="Server-authoritative advance balance" FontSize="11" Foreground="#065F46" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Credit Limit -->
                                <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16, 12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="CREDIT LIMIT" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.CreditLimitFormatted, Mode=OneWay}"
                                                   FontSize="22" FontWeight="Bold" Foreground="#2563EB"
                                                   AutomationProperties.AutomationId="CreditLimitDisplay" />
                                        <TextBlock Text="Maximum allowable debt ceiling" FontSize="11" Foreground="#1E40AF" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Tabbed Detail Workspace: Ledger, Payments, Sales -->
                            <Grid Grid.Row="2" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Tab Switcher -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Ledger Entries"
                                            Click="OnSelectLedgerTab"
                                            FontWeight="{x:Bind LedgerTabWeight, Mode=OneWay}"
                                            Background="{x:Bind LedgerTabBackground, Mode=OneWay}"
                                            Foreground="{x:Bind LedgerTabForeground, Mode=OneWay}"
                                            AutomationProperties.AutomationId="TabLedgerButton" />

                                    <Button Content="Payment History"
                                            Click="OnSelectPaymentsTab"
                                            FontWeight="{x:Bind PaymentsTabWeight, Mode=OneWay}"
                                            Background="{x:Bind PaymentsTabBackground, Mode=OneWay}"
                                            Foreground="{x:Bind PaymentsTabForeground, Mode=OneWay}"
                                            AutomationProperties.AutomationId="TabPaymentsButton" />

                                    <Button Content="Sales Invoices"
                                            Click="OnSelectSalesTab"
                                            FontWeight="{x:Bind SalesTabWeight, Mode=OneWay}"
                                            Background="{x:Bind SalesTabBackground, Mode=OneWay}"
                                            Foreground="{x:Bind SalesTabForeground, Mode=OneWay}"
                                            AutomationProperties.AutomationId="TabSalesButton" />
                                </StackPanel>

                                <!-- TAB 1: Ledger -->
                                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Visibility="{x:Bind LedgerTabVisibility, Mode=OneWay}">
                                    <ListView ItemsSource="{x:Bind ViewModel.LedgerEntries, Mode=OneWay}" AutomationProperties.AutomationId="LedgerListView">
                                        <ListView.HeaderTemplate>
                                            <DataTemplate>
                                                <Grid Padding="12, 10" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Date / Time" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                                                    <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                                                    <TextBlock Grid.Column="2" Text="Reference #" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                                                    <TextBlock Grid.Column="3" Text="Debt Δ" FontWeight="SemiBold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="4" Text="Credit Δ" FontWeight="SemiBold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="5" Text="Balance" FontWeight="SemiBold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="6" Text="Notes" Margin="16, 0, 0, 0" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.HeaderTemplate>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CustomerLedgerItemViewModel">
                                                <Grid Padding="12, 8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind TimestampLocal}" FontSize="12" Foreground="#334155" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind EntryType}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind ReferenceNumber}" FontSize="12" Foreground="#64748B" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind DebtChangeFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind DebtChangeForeground}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="4" Text="{x:Bind StoreCreditChangeFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind StoreCreditChangeForeground}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="5" Text="{x:Bind RunningDebtFormatted}" FontSize="12" Foreground="#334155" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="6" Text="{x:Bind Notes}" Margin="16, 0, 0, 0" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>

                                <!-- TAB 2: Payments -->
                                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Visibility="{x:Bind PaymentsTabVisibility, Mode=OneWay}">
                                    <ListView ItemsSource="{x:Bind ViewModel.PaymentHistory, Mode=OneWay}" AutomationProperties.AutomationId="PaymentsListView">
                                        <ListView.HeaderTemplate>
                                            <DataTemplate>
                                                <Grid Padding="12, 10" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Payment Date" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                                                    <TextBlock Grid.Column="1" Text="Amount" FontWeight="SemiBold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="2" Text="Method" Margin="16, 0, 0, 0" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                                                    <TextBlock Grid.Column="3" Text="Reference #" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                                                    <TextBlock Grid.Column="4" Text="Notes" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.HeaderTemplate>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CustomerPaymentItemViewModel">
                                                <Grid Padding="12, 8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind PaymentDateLocal}" FontSize="12" Foreground="#334155" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind AmountFormatted}" FontSize="12" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind MethodDisplay}" Margin="16, 0, 0, 0" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind ReferenceNumber}" FontSize="12" Foreground="#64748B" />
                                                    <TextBlock Grid.Column="4" Text="{x:Bind Notes}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>

                                <!-- TAB 3: Sales -->
                                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Visibility="{x:Bind SalesTabVisibility, Mode=OneWay}">
                                    <ListView ItemsSource="{x:Bind ViewModel.SalesHistory, Mode=OneWay}" AutomationProperties.AutomationId="SalesListView">
                                        <ListView.HeaderTemplate>
                                            <DataTemplate>
                                                <Grid Padding="12, 10" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Invoice Number" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                                                    <TextBlock Grid.Column="1" Text="Date / Time" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                                                    <TextBlock Grid.Column="2" Text="Total Amount" FontWeight="SemiBold" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="Status" Margin="16, 0, 0, 0" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                                                    <TextBlock Grid.Column="4" Text="Cashier" FontWeight="SemiBold" FontSize="12" Foreground="#475569" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.HeaderTemplate>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CustomerSaleItemViewModel">
                                                <Grid Padding="12, 8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind InvoiceNumber}" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind CreatedAtLocal}" FontSize="12" Foreground="#334155" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind FinalPayableFormatted}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind StatusDisplay}" Margin="16, 0, 0, 0" FontSize="12" Foreground="#334155" />
                                                    <TextBlock Grid.Column="4" Text="{x:Bind CashierName}" FontSize="12" Foreground="#64748B" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- MODAL OVERLAYS                                              -->
        <!-- ============================================================ -->

        <!-- 1. Create / Edit Customer Profile Modal -->
        <Grid Background="#7F000000" Visibility="{x:Bind CreateOrEditModalVisibility, Mode=OneWay}" AutomationProperties.AutomationId="CreateOrEditCustomerModal">
            <Border Background="White" CornerRadius="12" Padding="24" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.CreateOrEditTitle, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />

                    <InfoBar IsOpen="{x:Bind HasFormValidationError, Mode=OneWay}"
                             Severity="Error"
                             Title="Validation Error"
                             Message="{x:Bind ViewModel.FormValidationError, Mode=OneWay}"
                             IsClosable="False"
                             AutomationProperties.AutomationId="FormValidationInfoBar" />

                    <TextBox Header="Customer Name *"
                             PlaceholderText="e.g. Ramesh Kumar"
                             Text="{x:Bind ViewModel.FormName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="FormCustomerNameInput" />

                    <TextBox Header="Phone Number"
                             PlaceholderText="e.g. 9876543210"
                             Text="{x:Bind ViewModel.FormPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="FormCustomerPhoneInput" />

                    <TextBox Header="Email Address"
                             PlaceholderText="e.g. ramesh@example.com"
                             Text="{x:Bind ViewModel.FormEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="FormCustomerEmailInput" />

                    <TextBox Header="GSTIN (15 characters)"
                             PlaceholderText="e.g. 29AAAAA0000A1Z5"
                             Text="{x:Bind ViewModel.FormGstin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="FormCustomerGstinInput" />

                    <TextBox Header="Billing / Store Address"
                             PlaceholderText="Street, City, Postal Code"
                             Text="{x:Bind ViewModel.FormAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="FormCustomerAddressInput" />

                    <TextBox Header="Initial Credit Limit (₹)"
                             PlaceholderText="0.00"
                             Text="{x:Bind ViewModel.FormCreditLimitRupees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{x:Bind CreateCreditLimitVisibility, Mode=OneWay}"
                             AutomationProperties.AutomationId="FormCustomerCreditLimitInput" />

                    <TextBox Header="Notes"
                             PlaceholderText="Customer notes or preferences"
                             Text="{x:Bind ViewModel.FormNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             Height="60"
                             AutomationProperties.AutomationId="FormCustomerNotesInput" />

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0, 8, 0, 0">
                        <Button Content="Cancel" Click="OnCancelCreateOrEdit" AutomationProperties.AutomationId="CancelCustomerButton" />
                        <Button Content="Save Customer" Click="OnSaveCustomer" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SaveCustomerButton" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Repayment Workflow Modal (Safety Rules #1 & #2) -->
        <Grid Background="#7F000000" Visibility="{x:Bind RepaymentModalVisibility, Mode=OneWay}" AutomationProperties.AutomationId="RepaymentModal">
            <Border Background="White" CornerRadius="12" Padding="24" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Record Debt Repayment" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />

                    <!-- Customer context -->
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="12, 10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.Phone, Mode=OneWay}" FontSize="12" Foreground="#64748B" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Outstanding Debt" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedCustomer.OutstandingCreditFormatted, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="#E11D48" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Status Notification / Severity Bar -->
                    <InfoBar IsOpen="{x:Bind HasRepaymentStatus, Mode=OneWay}"
                             Severity="{x:Bind RepaymentBarSeverity, Mode=OneWay}"
                             Title="Repayment Status"
                             Message="{x:Bind ViewModel.RepaymentStatusMessage, Mode=OneWay}"
                             IsClosable="False"
                             AutomationProperties.AutomationId="RepaymentStatusInfoBar" />

                    <!-- Validation Error Bar -->
                    <InfoBar IsOpen="{x:Bind HasRepaymentValidationError, Mode=OneWay}"
                             Severity="Error"
                             Title="Validation Error"
                             Message="{x:Bind ViewModel.RepaymentValidationError, Mode=OneWay}"
                             IsClosable="False"
                             AutomationProperties.AutomationId="RepaymentValidationInfoBar" />

                    <!-- Amount Input -->
                    <TextBox Header="Repayment Amount (₹) *"
                             PlaceholderText="e.g. 500.00"
                             Text="{x:Bind ViewModel.RepaymentAmountRupees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="RepaymentAmountInput" />

                    <!-- Payment Method -->
                    <ComboBox Header="Payment Method *"
                              SelectedIndex="{x:Bind RepaymentMethodIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.AutomationId="RepaymentMethodComboBox">
                        <ComboBoxItem Content="Cash" />
                        <ComboBoxItem Content="Card" />
                        <ComboBoxItem Content="UPI" />
                        <ComboBoxItem Content="Cheque" />
                    </ComboBox>

                    <!-- Reference Number -->
                    <TextBox Header="Payment Reference Number (Mandatory for non-cash)"
                             PlaceholderText="e.g. UPI Ref / Card Auth / Cheque #"
                             Text="{x:Bind ViewModel.RepaymentReferenceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="RepaymentReferenceInput" />

                    <!-- Notes -->
                    <TextBox Header="Notes (Optional)"
                             PlaceholderText="e.g. Advance cleared for Invoice #1024"
                             Text="{x:Bind ViewModel.RepaymentNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="RepaymentNotesInput" />

                    <!-- Buttons -->
                    <Grid Margin="0, 10, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Ambiguous recovery buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind AmbiguousButtonsVisibility, Mode=OneWay}">
                            <Button Content="Retry (Same ID)" Click="OnRetryRepayment" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="RetryRepaymentButton" />
                            <Button Content="Verify Status" Click="OnVerifyRepayment" AutomationProperties.AutomationId="VerifyRepaymentButton" />
                        </StackPanel>

                        <!-- Standard buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Cancel" Click="OnCloseRepayment" AutomationProperties.AutomationId="CancelRepaymentButton" />
                            <Button Content="Submit Repayment"
                                    Click="OnSubmitRepayment"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind NormalSubmitButtonVisibility, Mode=OneWay}"
                                    AutomationProperties.AutomationId="SubmitRepaymentButton" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Adjust Credit Limit Modal (Role Restricted: Manager/Admin/Owner) -->
        <Grid Background="#7F000000" Visibility="{x:Bind CreditLimitModalVisibility, Mode=OneWay}" AutomationProperties.AutomationId="CreditLimitModal">
            <Border Background="White" CornerRadius="12" Padding="24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="Adjust Customer Credit Limit" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />

                    <InfoBar IsOpen="{x:Bind HasCreditLimitValidationError, Mode=OneWay}"
                             Severity="Error"
                             Title="Validation Error"
                             Message="{x:Bind ViewModel.CreditLimitValidationError, Mode=OneWay}"
                             IsClosable="False"
                             AutomationProperties.AutomationId="CreditLimitValidationInfoBar" />

                    <TextBox Header="New Credit Limit (₹) *"
                             PlaceholderText="e.g. 5000.00"
                             Text="{x:Bind ViewModel.NewCreditLimitRupees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="NewCreditLimitInput" />

                    <TextBox Header="Adjustment Reason (Mandatory) *"
                             PlaceholderText="e.g. Approved good payment history"
                             Text="{x:Bind ViewModel.CreditLimitReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             Height="60"
                             AutomationProperties.AutomationId="CreditLimitReasonInput" />

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0, 8, 0, 0">
                        <Button Content="Cancel" Click="OnCancelCreditLimit" AutomationProperties.AutomationId="CancelCreditLimitButton" />
                        <Button Content="Update Limit" Click="OnSaveCreditLimit" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SaveCreditLimitButton" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Toggle Active Status Modal (Role Restricted: Manager/Admin/Owner) -->
        <Grid Background="#7F000000" Visibility="{x:Bind StatusModalVisibility, Mode=OneWay}" AutomationProperties.AutomationId="StatusModal">
            <Border Background="White" CornerRadius="12" Padding="24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.StatusDialogTitle, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />

                    <InfoBar IsOpen="{x:Bind HasStatusValidationError, Mode=OneWay}"
                             Severity="Error"
                             Title="Validation Error"
                             Message="{x:Bind ViewModel.StatusValidationError, Mode=OneWay}"
                             IsClosable="False"
                             AutomationProperties.AutomationId="StatusValidationInfoBar" />

                    <TextBox Header="Reason for Status Change (Mandatory) *"
                             PlaceholderText="e.g. Customer requested deactivation or account cleared"
                             Text="{x:Bind ViewModel.StatusReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             Height="60"
                             AutomationProperties.AutomationId="StatusReasonInput" />

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0, 8, 0, 0">
                        <Button Content="Cancel" Click="OnCancelStatus" AutomationProperties.AutomationId="CancelStatusButton" />
                        <Button Content="Confirm Status" Click="OnSaveStatus" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ConfirmStatusButton" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
