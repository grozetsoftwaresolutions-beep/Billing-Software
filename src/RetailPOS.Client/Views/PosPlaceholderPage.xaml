<Page
    x:Class="RetailPOS.Client.Views.PosPlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F8FAFC">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
        <StackPanel MaxWidth="900" Spacing="24" HorizontalAlignment="Stretch">

            <!-- Header Card -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="32, 28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Width="44" Height="44" Background="#F0FDF4" CornerRadius="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BF;" FontSize="22" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="POS &amp; Billing" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="Checkout, Barcode Scanning &amp; Receipt Printing" FontSize="13" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="20" Padding="14, 6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#D97706" />
                            <TextBlock Text="MODULE SCHEDULED FOR NEXT PHASE" FontSize="11" FontWeight="Bold" Foreground="#92400E" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Architecture & Scope Card -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="32, 28">
                <StackPanel Spacing="20">
                    <TextBlock Text="MODULE STATUS &amp; ARCHITECTURE" FontSize="12" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="50" />
                    <TextBlock Text="The POS &amp; Billing presentation foundation is in place within the application shell. Full interactive billing, line-item cart management, and server-authoritative checkout will be implemented in a subsequent phase." FontSize="14" Foreground="#334155" LineHeight="22" TextWrapping="Wrap" />

                    <Border Height="1" Background="#F1F5F9" />

                    <TextBlock Text="PLANNED CAPABILITIES" FontSize="12" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="50" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="16, 12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Barcode Wedge Scanner" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="Instant item addition via low-level keyboard hook" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="16, 12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Authoritative Pricing &amp; Tax" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="Calculated strictly against server rules and contracts" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="16, 12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Invoice Sequencing" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="Gap-free, tamper-evident sequence numbers from server" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="16, 12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Hardware Receipt Printing" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="ESC/POS thermal printer and cash drawer trigger" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Content="Return to Home Dashboard" Click="OnReturnHomeClicked" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
