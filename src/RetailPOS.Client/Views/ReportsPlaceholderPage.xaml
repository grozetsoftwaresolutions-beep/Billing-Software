<Page
    x:Class="RetailPOS.Client.Views.ReportsPlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F8FAFC">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32">
        <StackPanel MaxWidth="900" Spacing="24" HorizontalAlignment="Stretch">

            <!-- Header Card -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="32, 28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Width="44" Height="44" Background="#FEF3C7" CornerRadius="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9F9;" FontSize="22" Foreground="#B45309" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Reports &amp; Analytics" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="Financial Summaries, Shift Audits &amp; Tax Reports" FontSize="13" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="20" Padding="14, 6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#D97706" />
                            <TextBlock Text="MODULE SCHEDULED FOR NEXT PHASE" FontSize="11" FontWeight="Bold" Foreground="#92400E" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Architecture & Scope Card -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="32, 28">
                <StackPanel Spacing="20">
                    <TextBlock Text="MODULE STATUS &amp; ARCHITECTURE" FontSize="12" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="50" />
                    <TextBlock Text="Reporting queries will execute against server analytics endpoints, enforcing RBAC permission controls (e.g. Manager/Owner required). The presentation layer renders verified aggregates without client-side data alterations." FontSize="14" Foreground="#334155" LineHeight="22" TextWrapping="Wrap" />

                    <Border Height="1" Background="#F1F5F9" />

                    <TextBlock Text="PLANNED CAPABILITIES" FontSize="12" FontWeight="Bold" Foreground="#64748B" CharacterSpacing="50" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="16, 12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Shift &amp; Register Reconciliation" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="Opening balance, cash-in/out, and closing drawer counts" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="16, 12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tax &amp; Discount Audits" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="Breakdown by tax category, rate tiers, and discount rules" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="16, 12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Sales Trends &amp; Hourly Velocity" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="Peak transaction hours, average basket size, and top items" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="16, 12" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Immutable Audit Log Inspection" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock Text="Cryptographically verifiable event history and security logs" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Content="Return to Home Dashboard" Click="OnReturnHomeClicked" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
