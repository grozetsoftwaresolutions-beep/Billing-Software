<Window
    x:Class="RetailPOS.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:RetailPOS.Client.ViewModels"
    mc:Ignorable="d"
    Title="GROZET RETAILPOS">

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Navigation / Branding Bar -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24, 16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Branding & Tagline -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="#1E3E62" CornerRadius="10" VerticalAlignment="Center">
                        <TextBlock Text="G" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.AppTitle, Mode=OneWay}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="POS CLIENT" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Status Indicators -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Server Status Badge -->
                    <Border Background="#1E293B" CornerRadius="16" Padding="14,6" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{x:Bind ServerStatusDotBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.ServerStatusText, Mode=OneWay}" Foreground="#F8FAFC" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Terminal Status Badge -->
                    <Border Background="#1E293B" CornerRadius="16" Padding="14,6" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.TerminalStatusText, Mode=OneWay}" Foreground="#F8FAFC" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" MaxWidth="720">
                <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="48, 40">
                    <StackPanel Spacing="24">
                        <!-- Header Icon & Titles -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" Background="#EFF6FF" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <FontIcon Glyph="&#xE7BF;" FontSize="28" Foreground="#1E3E62" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.AppTitle, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="15" Foreground="#64748B" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Subtle Divider -->
                        <Border Height="1" Background="#F1F5F9" />

                        <!-- Status Message Row -->
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="20, 16" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing Grid.Column="0" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="22" Height="22" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="14" FontWeight="Medium" Foreground="#334155" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- System Environment Details Grid -->
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="ARCHITECTURE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                    <TextBlock Text="WinUI 3 / Windows App SDK (x64)" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="RUNTIME TARGET" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                    <TextBlock Text=".NET 10 (Desktop / Local)" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="TERMINAL MACHINE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                    <TextBlock Text="{x:Bind ViewModel.MachineName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Background="#F8FAFC" CornerRadius="8" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="CLIENT VERSION" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                    <TextBlock Text="{x:Bind ViewModel.VersionInfo, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Footer -->
        <Border Grid.Row="2" Background="#E2E8F0" Padding="24, 10" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="© Grozet Software Solutions. All rights reserved." Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Enterprise Retail POS &amp; Billing Client" Foreground="#64748B" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
